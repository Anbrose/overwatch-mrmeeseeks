# 复制本文件为 .env（同一目录下），然后填写。.env 已被 .gitignore 忽略，不会被提交。

# 必填：Discord 开发者后台 → 你的应用 → Bot → Reset Token
DISCORD_TOKEN=

# 选填：Claude API Key（https://platform.claude.com 创建）
# 留空时 bot 只把截图转发到频道，不做分析，适合先调试截图时机
ANTHROPIC_API_KEY=

# 选填：分析用的模型，留空默认 claude-sonnet-5
CLAUDE_MODEL=

# WebSocket 端口，本地客户端连这里
# 用 Caddy/Nginx 反向代理加 HTTPS 时，把 WS_HOST 改成 127.0.0.1
WS_HOST=0.0.0.0
WS_PORT=8765

# 同一个客户端两次截图分析的最短间隔（秒）
MIN_SNAPSHOT_INTERVAL=5

# 英雄问答：英雄数据缓存文件，留空默认 server/herodata/heroes.json
HERO_DATA_PATH=
# 每隔多少小时从 Overwatch Wiki 刷新一次英雄数据
HERO_REFRESH_HOURS=24

# 选填：功能许愿频道 ID（右键频道 → 复制频道 ID）。频道里只能用表单提交，每人每天 2 次
WISH_CHANNEL_ID=
# 选填：每人每天能许几个愿，留空默认 2
WISH_DAILY_LIMIT=
# 选填：许愿表单里「哪个游戏」的下拉选项，逗号分隔，最多 24 个，末尾自动加 Other（手填小众游戏）
# 留空用默认列表：守望先锋 + 22 个热门游戏（见 server/wishes.py 的 DEFAULT_GAMES）
WISH_GAMES=
# 选填：最终审核人的用户 ID（右键自己 → 复制用户 ID）。方案里会请许愿人 @ 这个人；留空则写「找管理员」
# 起草方案要用 ANTHROPIC_API_KEY，没设置时许愿照常发出，只是没有方案
WISH_REVIEWER_ID=

# 开播通知（@mrmeeseeks live add）：轮询 B 站直播间状态的间隔（秒），最低 15，默认 30
LIVE_POLL_INTERVAL=
# 设为 1 时下播也发一条消息，默认只报开播
LIVE_NOTIFY_OFFLINE=

# 选填：一起看（@mrmeeseeks 一起看 <B站或YouTube链接>）网页的公网地址，例如 https://watch.example.com
# 留空则不启用一起看。用 Caddy/Nginx 反向代理加 HTTPS 时，把 WATCH_HOST 改成 127.0.0.1
WATCH_PUBLIC_URL=
# 一起看网页服务监听的地址和端口，默认 0.0.0.0 和 8080
WATCH_HOST=
WATCH_PORT=
# 选填：B 站登录 cookie，登录后才能拿到高画质。获取方法：浏览器登录 bilibili.com → F12 → Application
# → Cookies → https://www.bilibili.com → 复制 SESSDATA 的值。它等同于账号登录凭证，务必保密，不要发给别人或提交到仓库
# 留空时 B 站使用未登录画质
BILIBILI_SESSDATA=
# B 站最高画质：1080、720 或 480，默认 1080（还受账号权限限制）
WATCH_MAX_QUALITY=
# 同时播放 B 站视频的房间上限（B 站视频经服务器转流，占带宽），默认 2；YouTube 房间不限
WATCH_MAX_BILI_ROOMS=
