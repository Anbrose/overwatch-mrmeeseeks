# Caddy 反向代理示例：给 WebSocket 端口加上 HTTPS（wss://），Caddy 会自动申请证书。
# 前提：域名已解析到服务器，服务器放行 80 和 443 端口。
# 同时把 server/.env 里的 WS_HOST 改成 127.0.0.1，这样 8765 端口不再直接暴露到公网。
# 客户端连接地址改为：wss://meeseeks.example.com

meeseeks.example.com {
	reverse_proxy 127.0.0.1:8765
}

# 一起看网页（WATCH_PUBLIC_URL=https://watch.pigdogie.com.au）。
# reverse_proxy 默认支持 WebSocket；flush_interval -1 让视频流边收边发。
watch.pigdogie.com.au {
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
